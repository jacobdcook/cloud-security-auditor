# Copy this file to .env and fill in your own values. Never commit .env.
# The real .env is gitignored. Rotate any key that was ever present locally.

# Groq API key (https://console.groq.com/keys) - free tier
GROQ_API_KEY=your-groq-api-key-here

# Azure subscription to audit (treat as sensitive; do not commit)
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id-here
